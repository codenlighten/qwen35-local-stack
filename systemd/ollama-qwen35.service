[Unit]
Description=Ollama 0.32 (Qwen3.5 / qwen35 arch) on :__PORT__
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__PREFIX__/dist/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:__PORT__
# Both required for the documented context ceilings (halves the KV cache).
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
