[Unit]
Description=Qwen3.5 chat UI + OpenAI-compatible API on :__PORT__
After=ollama-qwen35.service
Wants=ollama-qwen35.service

[Service]
Type=simple
WorkingDirectory=__DIR__
ExecStart=/usr/bin/python3 __DIR__/chat.py --port __PORT__
# always, not on-failure: a clean exit from chat.py would otherwise
# leave the API down with systemd reporting success.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
